# Monorepo root env file for all apps/packages.
# Copy to .env and fill in values.

# Services
PORT=4000
JWT_SECRET=
RECAPTCHA_SECRET=
REDIS_HOST=
REDIS_PORT=
REDIS_PASSWORD=
REDIS_USERNAME=

# Database (Prisma PostgreSQL)
DATABASE_URL=

# Web + shared client packages (must stay NEXT_PUBLIC_)
NEXT_PUBLIC_SERVICES_URL=http://localhost:4000
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
NEXT_PUBLIC_TENOR_API_KEY=

# Optional
ANALYZE=false
