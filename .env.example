# Monorepo root env file for all apps/packages.
# Copy to .env and fill in values.

# Services
PORT=4000
JWT_SECRET=replace-with-a-long-random-secret
RECAPTCHA_SECRET=replace-with-google-recaptcha-secret

# Database (Prisma)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DB_NAME?schema=public

# Web + shared client packages (must stay NEXT_PUBLIC_)
NEXT_PUBLIC_SERVICES_URL=http://localhost:4000
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=replace-with-google-recaptcha-site-key
NEXT_PUBLIC_TENOR_API_KEY=replace-with-tenor-api-key

# Optional
ANALYZE=false
