		"@troof/config": "*",
		"@types/cookie-parser": "^1.4.6",
		"@types/jest": "^29.4.0",
		"@types/node": "18.16.9",
		"@typescript-eslint/eslint-plugin": "^6.9.1",
		"@typescript-eslint/parser": "^6.9.1",
		"esbuild": "^0.19.2",
		"eslint": "~8.48.0",
		"eslint-config-prettier": "^9.0.0",
		"jest": "^29.4.1",
		"jest-environment-node": "^29.4.1",
		"next": "13.0.4",
		"prettier": "^2.8.3",
		"prisma": "^5.1.1",
		"react-refresh": "^0.10.0",
		"ts-jest": "^29.1.0",
		"ts-node": "10.9.1",
		"tsconfig-paths": "^4.2.0",
		"turbo": "^1.6.3",
		"typescript": "~5.2.2",
		"url-loader": "^4.1.1"
	},
	"engines": {
