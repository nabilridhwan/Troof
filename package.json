{
	"name": "troof",
	"private": true,
	"version": "1.0.0",
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"repository": "https://github.com/nabilridhwan/GameNight.git",
	"author": "Nabil Ridhwan <nabridhwan@gmail.com>",
	"license": "MIT",
	"scripts": {
		"check-types": "tsc --noEmit",
		"start:services": "turbo run start --filter=services",
		"start:troof": "turbo run start --filter=web",
		"start:all": "turbo run start",
		"start:clean": "turbo run start --force",
		"test": "vitest run",
		"test:watch": "vitest",
		"prettier": "prettier --write .",
		"dev": "turbo run dev",
		"build:troof": "turbo run build --filter=web",
		"build:services": "turbo run build --filter=services",
		"build:all": "turbo run build",
		"ci": "npm ci",
		"prisma:generate": "prisma generate --config=./prisma.config.ts",
		"prisma:seed": "prisma db seed --config=./prisma.config.ts",
		"seed:truth-dare": "ts-node ./scripts/prisma/seed.ts"
	},
	"devDependencies": {
		"@swc/core": "^1.15.18",
		"@troof/config": "*",
		"@types/node": "^22.0.0",
		"@typescript-eslint/eslint-plugin": "^7.0.0",
		"@typescript-eslint/parser": "^7.0.0",
		"eslint": "~8.57.0",
		"eslint-config-prettier": "^9.0.0",
		"nodemon": "^3.1.0",
		"prettier": "^3.5.0",
		"prisma": "7.4.2",
		"ts-node": "^10.9.1",
		"tsconfig-paths": "^4.2.0",
		"turbo": "^2.8.17",
		"typescript": "^5.9.3",
		"vitest": "^3.2.4"
	},
	"packageManager": "npm@11.9.0",
	"engines": {
		"node": ">=18"
	},
	"dependencies": {
		"@prisma/client": "7.4.2",
		"tslib": "^2.3.0"
	},
	"overrides": {
		"prisma": "7.4.2",
		"@prisma/client": "7.4.2",
		"@prisma/adapter-pg": "^7.4.2",
		"@types/express-serve-static-core": "5.1.1",
		"hono": "4.12.5",
		"@hono/node-server": "1.19.11"
	},
	"prisma": {
		"seed": "ts-node ./scripts/prisma/seed.ts"
	}
}
