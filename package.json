{
	"name": "troof",
	"private": true,
	"version": "1.0.0",
	"main": "index.js",
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"repository": "https://github.com/nabilridhwan/GameNight.git",
	"author": "Nabil Ridhwan <nabridhwan@gmail.com>",
	"license": "MIT",
	"scripts": {
		"start:services": "turbo run start --scope=services",
		"start:troof": "turbo run start --scope=web",
		"start:all": "turbo run start",
		"start:clean": "turbo start --no-cache --force",
		"prettier": "prettier --write .",
		"dev": "turbo run dev",
		"build:troof": "npm install && turbo run build --scope=web",
		"build:services": "npm install && turbo run build --scope=services",
		"build:all": "npm install && turbo run build",
		"ci": "npm ci"
	},
	"devDependencies": {
		"@pmmmwh/react-refresh-webpack-plugin": "^0.5.7",
		"@svgr/webpack": "^8.0.1",
