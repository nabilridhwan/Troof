{
	"$schema": "https://turborepo.dev/schema.json",
	"tasks": {
		"//#prisma:generate": {
			"cache": false,
			"outputs": ["node_modules/.prisma/", "node_modules/@prisma/client/"]
		},
		"build": {
			"outputs": [".next/**", "!.next/cache/**", "**/dist*", "output/**"],
			"dependsOn": ["//#prisma:generate", "^build"]
		},
		"check-types": {
			"dependsOn": ["//#prisma:generate", "^check-types"]
		},
		"lint": {
			"outputs": []
		},
		"dev": {
			"cache": false,
			"persistent": true
		},
		"start": {
			"dependsOn": ["^build"]
		}
	}
}
